# API Configuration
PROJECT_NAME="Geospatial File Measurement API"
API_V1_STR="/api"
DEBUG=True

# Database Configuration
# Default: SQLite in local directory
DATABASE_URL="sqlite:///./geospatial.db"
# PostgreSQL/PostGIS example:
# DATABASE_URL="postgresql://user:password@localhost:5432/geospatial_db"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".kml", ".zip"]
